        android:fillColor="#263A4F"
        android:pathData="M30,58 H114 V122 H30 Z" />
    <path
        android:fillColor="#F2B84B"
        android:pathData="M96,68 A6,6 0 1 1 96,80 A6,6 0 1 1 96,68 Z" />
    <path
        android:fillColor="#3E6E5E"
