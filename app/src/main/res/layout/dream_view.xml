<?xml version="1.0" encoding="utf-8"?>
<!-- The screensaver window takes the app theme; it must be pure black instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="@dimen/dream_margin"
    tools:ignore="Overdraw">

    <!-- Shown only when something needs the user's attention; moved now and then to spare the panel. -->
    <TextView
        android:id="@+id/dream_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:maxWidth="640dp"
        android:textColor="@color/dream_text"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
